rules_version = '2';
// Question-bank images: public read so all users see illustrations reliably (no Auth/App Check).
// Download URLs and HTTPS fetches work from any client. Writes stay disabled.

service firebase.storage {
  match /b/{bucket}/o {
    match /taxi/bank/images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
