rules_version = '2';
// Bank images: valid App Check only (no Firebase Auth required).
// Taxi practice routes are public in the app, but App Check still restricts traffic to your app.
// Register iOS/Android under App Check; use debug provider + token for simulator/dev.
//
// Firebase Console: App Check → enforce for Cloud Storage (recommended).

service firebase.storage {
  match /b/{bucket}/o {
    match /taxi/bank/images/{allPaths=**} {
      allow read: if request.appCheck.valid;
      allow write: if false;
    }
  }
}
